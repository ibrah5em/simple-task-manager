# ─── Production env for x-server (tasks-app.duckdns.org) ───────────────
# Copy to .env on the host (NOT into the image — .dockerignore blocks .env).
# Fill in the blanks, then `docker compose up -d --build`.

APP_NAME="Simple Task Manager"
APP_ENV=production
APP_KEY=                                # generate with: docker run --rm -it stm:latest php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://tasks-app.duckdns.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Logging ───
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─── Database (SQLite on the stm-db volume) ───
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
DB_FOREIGN_KEYS=true

# ─── Sessions / cookies (HTTPS only) ───
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ─── Broadcasting / queues / cache ───
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Mail (no real outbound for now) ───
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tasks-app.duckdns.org"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Vite ───
VITE_APP_NAME="${APP_NAME}"

# ─── AI / OAuth / Push (leave empty until you wire them up) ───
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tasks-app.duckdns.org/auth/google/callback
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ebrahym.das@gmail.com
